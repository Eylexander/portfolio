MONGODB_URI=mongodb://portfolio_mongo:27017/portfolio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
GOTIFY_URL=http://portfolio_gotify:8080
GOTIFY_TOKEN=your_gotify_token_here
OLLAMA_URL=http://portfolio_ollama:11434
OLLAMA_MODEL=gpt-4
JWT_SECRET=default-secret-change-me

# Contact message digest email (sent twice a week, only if new messages arrived)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your_smtp_password_here
DIGEST_EMAIL_TO=you@example.com
# Weekdays to send the digest on (0=Sunday...6=Saturday), default: 1,4 (Mon & Thu)
DIGEST_DAYS=1,4
# Hour of day (0-23, server time) to send the digest, default: 9
DIGEST_HOUR=9